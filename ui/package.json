{
  "name": "renocorp-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "RENOCORP — production React frontend (Vite + custom design system, no CSS framework)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
